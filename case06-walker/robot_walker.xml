<!--
Walker2D model for `Walker2d-v5`, based on openai/gym/Walker2d
modified by @kallinteris-Andreas
  - To not require `coordinate="global"`
  - Set feet friction to 1.9
-->
<!-- Visual restyle for the article video (case06-walker/render_robot.py): colours, materials and massless
     <site> markers only. Geom sizes, positions, densities and all physics are identical to walker2d_v5.xml. -->
<mujoco model="walker2d">
  <compiler angle="degree" inertiafromgeom="true"/>
  <default>
    <joint armature="0.01" damping=".1" limited="true"/>
    <geom conaffinity="0" condim="3" contype="1" density="1000" friction=".7 .1 .1" rgba="0.8 0.6 .4 1"/>
  </default>
  <option integrator="RK4" timestep="0.002"/>
  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1"/>
    <geom conaffinity="1" condim="3" name="floor" pos="0 0 0" rgba="0.8 0.9 0.8 1" size="400 400 40" type="plane" material="MatPlane"/>
    <body name="torso" pos="0 0 1.25">
      <camera name="track" mode="trackcom" pos="0 -3 -0.25" xyaxes="1 0 0 0 0 1"/>
      <joint armature="0" axis="1 0 0" damping="0" limited="false" name="rootx" pos="0 0 -1.25" stiffness="0" type="slide"/>
      <joint armature="0" axis="0 0 1" damping="0" limited="false" name="rootz" pos="0 0 -1.25" ref="1.25" stiffness="0" type="slide"/>
      <joint armature="0" axis="0 1 0" damping="0" limited="false" name="rooty" pos="0 0 0" stiffness="0" type="hinge"/>
      <site name="head" type="box" pos="0 0 0.32" size=".085 .07 .075" rgba=".86 .88 .92 1" material="silver"/>
      <site name="visor" type="box" pos="0.082 0 0.335" size=".012 .055 .025" rgba=".35 .85 1 1"/>
      <site name="chest" type="box" pos="0 0 0.06" size=".085 .085 .15" rgba=".78 .8 .85 1" material="silver"/>
      <site name="hip_cap" type="sphere" pos="0 0 -0.2" size=".075" rgba=".95 .45 .1 1" material="metal"/>
      <geom friction="0.9" name="torso_geom" material="silver" rgba=".82 .84 .88 1" size="0.050000000000000003 0.19999999999999996" type="capsule"/>
      <body name="thigh" pos="0 0 -0.19999999999999996">
        <joint axis="0 -1 0" name="thigh_joint" pos="0 0 0" range="-150 0" type="hinge"/>
        <site name="thigh_shell" type="capsule" pos="0 0 -0.225" size=".07 .17" rgba=".4 .43 .5 1" material="metal"/>
        <geom friction="0.9" pos="0 0 -0.22500000000000009" name="thigh_geom" material="metal" rgba=".36 .39 .45 1" size="0.050000000000000003 0.22500000000000003" type="capsule"/>
        <body name="leg" pos="0 0 -0.70000000000000007">
          <joint axis="0 -1 0" name="leg_joint" pos="0 0 0.25" range="-150 0" type="hinge"/>
          <site name="leg_shell" type="capsule" pos="0 0 0" size=".06 .19" rgba=".4 .43 .5 1" material="metal"/>
          <site name="leg_knee_cap" type="sphere" pos="0 0 0.25" size=".06" rgba=".95 .45 .1 1" material="metal"/>
          <geom friction="0.9" name="leg_geom" material="metal" rgba=".36 .39 .45 1" size="0.040000000000000001 0.25" type="capsule"/>
          <body name="foot" pos="0.20000000000000001 0 -0.34999999999999998">
            <joint axis="0 -1 0" name="foot_joint" pos="-0.20000000000000001 0 0.10000000000000001" range="-45 45" type="hinge"/>
            <site name="foot_box" type="box" pos="-0.08 0 0.07" size=".14 .065 .035" rgba=".4 .43 .5 1" material="metal"/>
            <site name="foot_ankle_cap" type="sphere" pos="-0.2 0 0.1" size=".05" rgba=".95 .45 .1 1" material="metal"/>
            <geom friction="1.9" pos="-0.10000000000000001 0 0.10000000000000001" quat="0.70710678118654757 0 -0.70710678118654746 0" name="foot_geom" material="metal" rgba=".36 .39 .45 1" size="0.059999999999999998 0.10000000000000001" type="capsule"/>
          </body>
        </body>
      </body>
      <!-- copied and then replace thigh->thigh_left, leg->leg_left, foot->foot_right -->
      <body name="thigh_left" pos="0 0 -0.19999999999999996">
        <joint axis="0 -1 0" name="thigh_left_joint" pos="0 0 0" range="-150 0" type="hinge"/>
        <site name="thigh_left_shell" type="capsule" pos="0 0 -0.225" size=".07 .17" rgba=".25 .27 .32 1" material="metal"/>
        <geom friction="0.9" name="thigh_left_geom" material="metal" rgba=".2 .22 .26 1" size="0.050000000000000003 0.22500000000000003" pos="0 0 -0.22500000000000009" type="capsule"/>
        <body name="leg_left" pos="0 0 -0.70000000000000007">
          <joint axis="0 -1 0" name="leg_left_joint" pos="0 0 0.25" range="-150 0" type="hinge"/>
          <site name="leg_left_shell" type="capsule" pos="0 0 0" size=".06 .19" rgba=".25 .27 .32 1" material="metal"/>
          <site name="leg_left_knee_cap" type="sphere" pos="0 0 0.25" size=".06" rgba=".95 .45 .1 1" material="metal"/>
          <geom friction="0.9" name="leg_left_geom" material="metal" rgba=".2 .22 .26 1" size="0.040000000000000001 0.25" type="capsule"/>
          <body name="foot_left" pos="0.20000000000000001 0 -0.34999999999999998">
            <joint axis="0 -1 0" name="foot_left_joint" pos="-0.20000000000000001 0 0.10000000000000001" range="-45 45" type="hinge"/>
            <site name="foot_left_box" type="box" pos="-0.08 0 0.07" size=".14 .065 .035" rgba=".25 .27 .32 1" material="metal"/>
            <site name="foot_left_ankle_cap" type="sphere" pos="-0.2 0 0.1" size=".05" rgba=".95 .45 .1 1" material="metal"/>
            <geom friction="1.9" name="foot_left_geom" material="metal" rgba=".2 .22 .26 1" size="0.059999999999999998 0.10000000000000001" pos="-0.10000000000000001 0 0.10000000000000001" type="capsule" quat="0.70710678118654757 0 -0.70710678118654746 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- <motor joint="torso_joint" ctrlrange="-100.0 100.0" isctrllimited="true"/>-->
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="100" joint="thigh_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="100" joint="leg_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="100" joint="foot_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="100" joint="thigh_left_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="100" joint="leg_left_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="100" joint="foot_left_joint"/>
    <!-- <motor joint="finger2_rot" ctrlrange="-20.0 20.0" isctrllimited="true"/>-->
  </actuator>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1=".55 .62 .72" rgb2=".1 .12 .16"
            width="100" height="100"/>
        <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom" random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
        <texture builtin="checker" height="100" name="texplane" rgb1=".16 .17 .2" rgb2=".23 .25 .29" mark="edge" markrgb=".33 .36 .42" type="2d" width="100"/>
        <material name="MatPlane" reflectance="0.15" shininess="0.6" specular="0.4" texrepeat="600 600" texture="texplane"/>
        <material name="metal" specular="0.7" shininess="0.8" reflectance="0.05"/>
        <material name="silver" specular="0.9" shininess="0.9" reflectance="0.1"/>
        <material name="geom" texture="texgeom" texuniform="true"/>
    </asset>
</mujoco>
